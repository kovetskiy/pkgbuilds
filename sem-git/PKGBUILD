# Maintainer: Egor Kovetskiy <e.kovetskiy@gmail.com>
pkgname=sem-git
_pkgname=sem
pkgver=${PKGVER:-autogenerated}
pkgrel=${PKGREL:-1}
pkgdesc="Semantic version control CLI with entity-level diffs, blame, and impact analysis"
arch=('x86_64' 'aarch64')
url="https://github.com/Ataraxy-Labs/sem"
license=('MIT' 'Apache-2.0')
depends=(
	'git'
	'glibc'
	'libgcc'
	'libgit2'
	'openssl'
)
makedepends=(
	'cargo'
	'git'
	'pkgconf'
)
provides=('sem-cli')
conflicts=('sem-cli')
source=(
	"$_pkgname::git+https://github.com/Ataraxy-Labs/sem#branch=${BRANCH:-main}"
)
sha256sums=(
	'SKIP'
)

pkgver() {
	if [[ "$PKGVER" ]]; then
		echo "$PKGVER"
		return
	fi

	cd "$srcdir/$_pkgname"
	git describe --long --tags --abbrev=7 |
		sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
	cd "$srcdir/$_pkgname/crates"

	export CARGO_HOME="$srcdir/cargo-home"

	cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
	cd "$srcdir/$_pkgname/crates"

	export CARGO_HOME="$srcdir/cargo-home"
	export LIBGIT2_NO_VENDOR=1
	export CFLAGS="${CFLAGS:+$CFLAGS }-ffile-prefix-map=$srcdir=/usr/src/$pkgname"
	export CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }-ffile-prefix-map=$srcdir=/usr/src/$pkgname"
	export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }--remap-path-prefix=$srcdir=/usr/src/$pkgname"
	export CARGO_TARGET_DIR=target

	cargo build --frozen --release --package sem-cli
}

package() {
	cd "$srcdir/$_pkgname"

	# GNU Parallel owns /usr/bin/sem on Arch. Use sem-cli so this package
	# can coexist with devtools, which depends on parallel.
	install -Dm755 crates/target/release/sem \
		"$pkgdir/usr/bin/sem-cli"
	install -Dm644 LICENSE-MIT \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
	install -Dm644 LICENSE-APACHE \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
	install -Dm644 README.md \
		"$pkgdir/usr/share/doc/$pkgname/README.md"
}
